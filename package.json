{
  "name": "louis-video-downloader",
  "version": "0.1.0",
  "description": "Polished Windows desktop downloader for public and user-accessible videos.",
  "main": "dist/main/index.js",
  "author": "Louis",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "video-downloader",
    "electron",
    "windows"
  ],
  "homepage": "https://github.com/plpk/videodownloader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plpk/videodownloader.git"
  },
  "bugs": {
    "url": "https://github.com/plpk/videodownloader/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.louis.videodownloader",
    "productName": "Video Downloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
